{
  "expo": {
    "name": "AlkhidmatVolunteer",
    "slug": "AlkhidmatVolunteer",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "alkhidmatvolunteer",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.alkhidmat.volunteer"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/AlkhidmatVolunteer"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cb19b74a-aa8f-4683-8021-0dc64672a9a0"
      }
    },
    "owner": "daniyal771"
  }
}
